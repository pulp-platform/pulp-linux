From: bluew <bluewww@users.noreply.github.com>
Date: Fri, 2 Feb 2024 18:22:42 +0100
Subject: [PATCH 6/7] cheshire: Fix DT load address to not overlap with kernel
 initramfs

---
 platform/fpga/cheshire/config.mk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/platform/fpga/cheshire/config.mk b/platform/fpga/cheshire/config.mk
index 2d4d086..831df02 100644
--- a/platform/fpga/cheshire/config.mk
+++ b/platform/fpga/cheshire/config.mk
@@ -21,7 +21,7 @@ ifeq ($(PLATFORM_RISCV_XLEN), 32)
  FW_JUMP_ADDR=0x80200000
  endif
 # TODO: this is a cancerous workaround; set this correctly, ideally built!
-FW_JUMP_FDT_ADDR=0x80800000
+FW_JUMP_FDT_ADDR=0x81000000
 
 # Firmware with payload configuration.
 FW_PAYLOAD=y
@@ -34,5 +34,5 @@ else
   FW_PAYLOAD_OFFSET=0x200000
 endif
 # TODO: this is a cancerous workaround; set this correctly, ideally built!
-FW_PAYLOAD_FDT_ADDR=0x80800000
+FW_PAYLOAD_FDT_ADDR=0x81000000
 FW_PAYLOAD_ALIGN=0x1000
