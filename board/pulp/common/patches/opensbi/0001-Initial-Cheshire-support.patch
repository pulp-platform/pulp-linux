From: Christopher Reinwardt <christopher.reinwardt@web.de>
Date: Fri, 28 Oct 2022 13:17:16 +0200
Subject: [PATCH 1/7] Initial Cheshire support

---
 platform/fpga/cheshire/config.mk  |  36 ++++++
 platform/fpga/cheshire/objects.mk |   8 ++
 platform/fpga/cheshire/platform.c | 187 ++++++++++++++++++++++++++++++
 3 files changed, 231 insertions(+)
 create mode 100644 platform/fpga/cheshire/config.mk
 create mode 100644 platform/fpga/cheshire/objects.mk
 create mode 100644 platform/fpga/cheshire/platform.c

diff --git a/platform/fpga/cheshire/config.mk b/platform/fpga/cheshire/config.mk
new file mode 100644
index 0000000..e731187
--- /dev/null
+++ b/platform/fpga/cheshire/config.mk
@@ -0,0 +1,36 @@
+#
+# SPDX-License-Identifier: BSD-2-Clause
+#
+# Copyright (C) 2019 FORTH-ICS/CARV
+#		Panagiotis Peristerakis <perister@ics.forth.gr>
+#
+
+#for more infos, check out /platform/template/config.mk
+
+PLATFORM_RISCV_XLEN = 64
+
+# Blobs to build
+FW_TEXT_START=0x80000000
+FW_JUMP=n
+
+ifeq ($(PLATFORM_RISCV_XLEN), 32)
+ # This needs to be 4MB aligned for 32-bit support
+ FW_JUMP_ADDR=0x80400000
+ else
+ # This needs to be 2MB aligned for 64-bit support
+ FW_JUMP_ADDR=0x80200000
+ endif
+FW_JUMP_FDT_ADDR=0x70000000
+
+# Firmware with payload configuration.
+FW_PAYLOAD=y
+
+ifeq ($(PLATFORM_RISCV_XLEN), 32)
+# This needs to be 4MB aligned for 32-bit support
+  FW_PAYLOAD_OFFSET=0x400000
+else
+# This needs to be 2MB aligned for 64-bit support
+  FW_PAYLOAD_OFFSET=0x200000
+endif
+FW_PAYLOAD_FDT_ADDR=0x70000000
+FW_PAYLOAD_ALIGN=0x1000
diff --git a/platform/fpga/cheshire/objects.mk b/platform/fpga/cheshire/objects.mk
new file mode 100644
index 0000000..814e6da
--- /dev/null
+++ b/platform/fpga/cheshire/objects.mk
@@ -0,0 +1,8 @@
